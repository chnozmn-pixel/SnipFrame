<Window x:Class="SnipFrame.Setup.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipFrame Setup"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Icon="/Assets/AppGlyph.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <StackPanel Margin="24,20,24,22">

        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/AppGlyph.png" Width="56" Height="56"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Install SnipFrame"
                           FontSize="21" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="SubtitleText" Text="Version 1.1.0 for Windows"
                           FontSize="12" Margin="0,3,0,0"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="IntroText" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                   Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}" />

        <TextBlock x:Name="LocationLabel" Text="Install location"
                   FontSize="12" Margin="0,18,0,6"
                   Foreground="{StaticResource MutedBrush}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LocationBox" Style="{StaticResource FlatTextBox}" />
            <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse…"
                    Style="{StaticResource SecondaryButton}" Click="OnBrowseClick" />
        </Grid>

        <CheckBox x:Name="DesktopShortcut" Content="Create a desktop shortcut"
                  Style="{StaticResource FlatCheckBox}" Margin="0,14,0,0" IsChecked="True" />

        <StackPanel x:Name="ProgressPanel" Margin="0,18,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="Progress" Style="{StaticResource FlatProgress}"
                         Minimum="0" Maximum="100" />
            <TextBlock x:Name="ProgressText" FontSize="11" Margin="0,8,0,0"
                       Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <Grid x:Name="ActionRow" Margin="0,22,0,0">
            <TextBlock x:Name="HintText" FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnCancelClick" Margin="0,0,8,0" />
                <Button x:Name="InstallButton" Content="Install"
                        Style="{StaticResource PrimaryButton}" Click="OnInstallClick" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="DonePanel" Visibility="Collapsed" Margin="0,18,0,0">
            <TextBlock x:Name="DoneTitle" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="DoneBody" FontSize="12" TextWrapping="Wrap"
                       Margin="0,4,0,0" LineHeight="18"
                       Foreground="{StaticResource MutedBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButton}"
                        Click="OnLaunchClick" Margin="0,0,8,0" />
                <Button x:Name="CloseButton" Style="{StaticResource SecondaryButton}"
                        Click="OnCloseClick" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
</Window>
