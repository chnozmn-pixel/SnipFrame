<Window x:Class="SnipFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipFrame"
        Width="528" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True">

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F4F4F7" Offset="0" />
                        <GradientStop Color="#C9C9D1" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="⛶" FontSize="23" Foreground="#1A1A1F"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Margin="12,2,0,0">
                <TextBlock x:Name="HeaderTitle" Text="SnipFrame" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="HeaderSubtitle" Text="Capture, mark up, share."
                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Primary action -->
        <Button x:Name="NewSnipButton" Grid.Row="1" Style="{StaticResource PrimaryButton}"
                Click="OnNewSnipClick" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="NewSnipHotkey" DockPanel.Dock="Right" Text="Ctrl+Shift+X"
                           Foreground="#61616A" FontWeight="Normal" FontSize="11.5"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="NewSnipLabel" Text="New Snip" />
            </DockPanel>
        </Button>

        <!-- Capture cards -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="WindowCard" Grid.Column="0" Style="{StaticResource Card}" Cursor="Hand"
                    MouseLeftButtonUp="OnWindowCardClick">
                <StackPanel>
                    <TextBlock Text="▭" FontSize="19" Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="WindowCardTitle" Text="Window" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock x:Name="WindowCardHint" Text="Click a window" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="FullCard" Grid.Column="2" Style="{StaticResource Card}" Cursor="Hand"
                    MouseLeftButtonUp="OnFullCardClick">
                <StackPanel>
                    <TextBlock Text="🖥" FontSize="17" Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="FullCardTitle" Text="Full Screen" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock x:Name="FullCardHint" Text="Capture the whole display" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tool row -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ToolLabel" Text="Tool" Style="{StaticResource Label}" />
            <StackPanel x:Name="ToolPanel" Grid.Column="1" Orientation="Horizontal" />
        </Grid>

        <!-- Delay row -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DelayLabel" Text="Delay" Style="{StaticResource Label}" />
            <ComboBox x:Name="DelayCombo" Grid.Column="1" Width="132" HorizontalAlignment="Left"
                      SelectionChanged="OnDelayChanged" />
        </Grid>

        <!-- Shortcut row -->
        <Grid Grid.Row="5" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ShortcutLabel" Text="Shortcut" Style="{StaticResource Label}" />
            <Border x:Name="ShortcutBox" Grid.Column="1" Width="160" Height="26" CornerRadius="6"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="OnShortcutClick">
                <TextBlock x:Name="ShortcutText" Text="Ctrl+Shift+X" FontSize="12"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Button x:Name="ResetButton" Grid.Column="2" Content="Reset" Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0" Padding="10,3" Click="OnResetShortcutClick" />
        </Grid>

        <!-- Language row -->
        <Grid Grid.Row="6" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LanguageLabel" Text="Language" Style="{StaticResource Label}" />
            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                      SelectionChanged="OnLanguageChanged" />
        </Grid>
    </Grid>
</Window>
