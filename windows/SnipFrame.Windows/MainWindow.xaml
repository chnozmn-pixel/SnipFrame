<Window x:Class="SnipFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipFrame"
        Width="486" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Icon="/Assets/AppGlyph.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <StackPanel Margin="22,18,22,22">

        <!-- App header -->
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/AppGlyph.png" Width="52" Height="52"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitle" Text="SnipFrame"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="HeaderSubtitle" Text="Capture, mark up, share."
                           FontSize="12" Margin="0,3,0,0"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Hero action -->
        <Button x:Name="NewSnipButton" Style="{StaticResource PrimaryButton}"
                Height="48" Margin="0,20,0,0"
                HorizontalContentAlignment="Stretch"
                Click="OnNewSnipClick">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0"
                      Data="{StaticResource Icon.Region}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Width="17" Height="17" Stretch="Uniform"
                      VerticalAlignment="Center" />
                <TextBlock x:Name="NewSnipLabel" Grid.Column="1" Text="New Snip"
                           FontSize="14" FontWeight="SemiBold"
                           Margin="9,0,0,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Height="21" CornerRadius="6.5"
                        Background="#29000000" Padding="8,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="NewSnipHotkey" Text="Ctrl+Shift+X"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Button>

        <!-- Secondary capture tiles -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="WindowCard" Grid.Column="0" Style="{StaticResource TileButton}"
                    Click="OnWindowCardClick">
                <StackPanel VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.Window}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="22" Height="22" Stretch="Uniform"
                          HorizontalAlignment="Center" />
                    <TextBlock x:Name="WindowCardTitle" Text="Window"
                               FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,7,0,0" />
                    <TextBlock x:Name="WindowCardHint" Text="Capture a single window"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Button>

            <Button x:Name="FullCard" Grid.Column="2" Style="{StaticResource TileButton}"
                    Click="OnFullCardClick">
                <StackPanel VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.Display}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="22" Height="22" Stretch="Uniform"
                          HorizontalAlignment="Center" />
                    <TextBlock x:Name="FullCardTitle" Text="Full Screen"
                               FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,7,0,0" />
                    <TextBlock x:Name="FullCardHint" Text="Capture the whole display"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Default tool -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ToolLabel" Grid.Column="0" Text="Tool"
                       FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
            <Border Grid.Column="1" HorizontalAlignment="Left"
                    Background="{StaticResource TrackBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="2">
                <StackPanel x:Name="ToolPanel" Orientation="Horizontal" />
            </Border>
        </Grid>

        <Border Height="1" Background="#38383C" Margin="0,18,0,0" />

        <!-- Preferences -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DelayLabel" Grid.Column="0" Text="Delay"
                       FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
            <ComboBox x:Name="DelayCombo" Grid.Column="1" Width="132" HorizontalAlignment="Left"
                      Style="{StaticResource FlatCombo}" SelectionChanged="OnDelayChanged" />
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ShortcutLabel" Grid.Column="0" Text="Shortcut"
                       FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
            <Border x:Name="ShortcutBox" Grid.Column="1" Width="132" Height="24"
                    HorizontalAlignment="Left" CornerRadius="6"
                    Background="{StaticResource FieldBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" Cursor="Hand"
                    MouseLeftButtonUp="OnShortcutClick">
                <TextBlock x:Name="ShortcutText" Text="Ctrl+Shift+X"
                           FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Button x:Name="ResetButton" Grid.Column="2" Content="Reset"
                    Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                    Click="OnResetShortcutClick" />
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LanguageLabel" Grid.Column="0" Text="Language"
                       FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                      Style="{StaticResource FlatCombo}" SelectionChanged="OnLanguageChanged" />
        </Grid>

    </StackPanel>
</Window>
