<Window x:Class="SnipFrame.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SnipFrame"
        Title="SnipFrame — Edit"
        Height="520" Width="820"
        MinWidth="740" MinHeight="300"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Icon="/Assets/AppGlyph.png"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UndoButton" Style="{StaticResource IconButton}"
                            Click="OnUndoClick" Margin="0,0,2,0" />
                    <Button x:Name="RedoButton" Style="{StaticResource IconButton}"
                            Click="OnRedoClick" Margin="0,0,9,0" />

                    <Border Width="1" Height="20" Background="{StaticResource StrokeBrush}"
                            Margin="0,0,9,0" />

                    <Border Background="{StaticResource TrackBrush}"
                            BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="2"
                            VerticalAlignment="Center">
                        <StackPanel x:Name="ToolPanel" Orientation="Horizontal" />
                    </Border>

                    <Border x:Name="ColorSwatch" Width="36" Height="24" Margin="10,0,0,0"
                            CornerRadius="5" BorderThickness="1"
                            BorderBrush="{StaticResource StrokeBrush}"
                            Background="#1C1C1E" Cursor="Hand"
                            MouseLeftButtonUp="OnColorClick" />

                    <Slider x:Name="WidthSlider" Style="{StaticResource FlatSlider}"
                            Width="90" Minimum="1" Maximum="12" Value="3"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            LargeChange="1" SmallChange="1" />
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Column="1"
                           FontSize="11" Margin="8,0"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SaveButton" Content="Save…"
                            Style="{StaticResource CompactSecondary}"
                            Click="OnSaveClick" Margin="0,0,6,0" />
                    <Button x:Name="CopyButton" Content="Copy"
                            Style="{StaticResource CompactPrimary}"
                            Click="OnCopyClick" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#141416">
            <Grid x:Name="SurfaceHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                <local:AnnotationCanvas x:Name="Surface" />
                <Canvas x:Name="Overlay" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
